# Rust
/target
**/*.rs.bk
Cargo.lock.bak

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
python/liteocr/_core*.so
python/liteocr/_core*.pyd
python/liteocr/_core.abi3.*

# Env / secrets
.env
.env.*
!.env.example

# Benchmark scratch
benchmark/runs/
benchmark/cache/
*.tmp
.DS_Store
benchmark/site/dist/
website/dist/
.claude/worktrees/
# in-progress `bench run` logs (removed when the run completes)
*.partial.jsonl
# Provider outputs for research-only sources (OmniDocBench) are never committed; their scores are
# kept in the result JSON and re-scored with `bench rescore --keep-missing` (ADR-16).
benchmark/results/outputs/*/*/omnidocbench/
