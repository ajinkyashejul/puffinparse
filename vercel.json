{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'deps resolved by uv run at build time'",
  "buildCommand": "uv run --no-project --with markdown --with pillow python website/build.py --out website/dist --site-url https://liteocr.vercel.app",
  "outputDirectory": "website/dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)/index.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/getting-started/",
      "destination": "/docs/getting-started/",
      "permanent": true
    },
    {
      "source": "/python/",
      "destination": "/docs/python/",
      "permanent": true
    },
    {
      "source": "/typescript/",
      "destination": "/docs/typescript/",
      "permanent": true
    },
    {
      "source": "/cli/",
      "destination": "/docs/cli/",
      "permanent": true
    },
    {
      "source": "/gateway/",
      "destination": "/docs/gateway/",
      "permanent": true
    },
    {
      "source": "/rust/",
      "destination": "/docs/rust/",
      "permanent": true
    },
